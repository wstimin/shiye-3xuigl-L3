[Unit]
Description=Shiye API Service
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/opt/shiye
EnvironmentFile=/opt/shiye/.env
ExecStart=/usr/bin/node /opt/shiye/apps/api/dist/main.js
Restart=always
RestartSec=3
User=shiye
Group=shiye

[Install]
WantedBy=multi-user.target
